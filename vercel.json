{
  "framework": "create-react-app",
  "installCommand": "cd frontend && yarn install --frozen-lockfile",
  "buildCommand": "cd frontend && CI=false yarn build",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    },
    "backend/routes/*": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/media/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "USE_DB_STORAGE": "true",
    "MONGO_URL": "mongodb://localhost:27017",
    "DB_NAME": "hanif_portfolio",
    "FRONTEND_ORIGINS": "http://localhost:3000,https://narative-storyteller.vercel.app"
  }
}
