{
  "framework": "create-react-app",
  "installCommand": "cd frontend && yarn install --frozen-lockfile",
  "buildCommand": "cd frontend && CI=false yarn build",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/media/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "USE_DB_STORAGE": "true",
    "DB_NAME": "hanif_portfolio",
    "MONGO_URL": "",
    "FRONTEND_ORIGINS": "https://narative-storyteller.vercel.app",
    "ADMIN_EMAIL": "",
    "ADMIN_PASSWORD_HASH": "",
    "ADMIN_NAME": "",
    "COOKIE_SECURE": "true"
  }
}
