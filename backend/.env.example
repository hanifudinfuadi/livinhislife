# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=hanif_portfolio

# FRONTEND_URL=http://localhost:3000,https://your-project.vercel.app
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3002,https://livinhislife.vercel.app,https://livinhislife-git-main-hanifudinfuadi.vercel.app
COOKIE_SECURE=false

# Private email/password login for the portfolio administrator
ADMIN_EMAIL=mhanifudinfuadi@gmail.com
ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$your$hash_replace_with_set_admin_password.py
ADMIN_NAME=Hanifudin

# Critical: Enable DB storage for Vercel deployment (filesystem is read-only)
USE_DB_STORAGE=true

# Vercel environment variables (from vercel.json)
VERCEL=true

# =============================================================================
# NOVELIST AI Configuration (Asisten Karya Tulis)
# BISA memasang SATU, DUA, atau KETIGA provider sekaligus.
# Jika lebih dari satu terpasang, sistem memakai FALLBACK berantai:
# provider pertama yang dipakai dulu; kalau gagal (quota/error), otomatis
# pindah ke provider berikutnya tanpa perlu restart.
# =============================================================================

# --- OPSI 1: OPENAI (paling fleksibel & cepat) ---
# Dapatkan API key di: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# --- OPSI 2: ANTHROPIC (terbaik untuk creative writing) ---
# Dapatkan API key di: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- OPSI 3: GOOGLE GEMINI (terbaik untuk konteks panjang) ---
# Dapatkan API key di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3-flash-preview

# --- Provider utama yang dipakai lebih dulu (openai | anthropic | gemini) ---
AI_MODEL_PROVIDER=openai
AI_MODEL_NAME=gpt-4o-mini

# --- Urutan FALLBACK antar-provider (pisahkan dengan koma) ---
# Semua provider yang terdaftar di sini dan punya API key akan dicoba
# berurutan sampai satu berhasil.
AI_FALLBACK_PROVIDERS=openai,anthropic,gemini

# --- OPSI 4: EMERGENT (Proxy-based, legacy) ---
# EMERGENT_LLM_KEY="sk-emergent-[your-key]"
# LLM_API_BASE=https://api.emergent.llm.com/openai/v1

# --- OPSIONAL: Provider OpenAI-compatible lain (Groq, Together, DeepSeek, OpenRouter) ---
# LLM_API_KEY="your-custom-key"
# LLM_API_BASE=https://api.your-provider.com/v1
# AI_MODEL_PROVIDER=openai
# AI_MODEL_NAME=gpt-4o-mini