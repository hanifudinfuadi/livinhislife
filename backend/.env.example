# MongoDB Configuration (Wajib di-set)
MONGO_URL=mongodb://localhost:27017
DB_NAME=hanif_portfolio

# FRONTEND_URL=http://localhost:3000,https://your-project.vercel.app
FRONTEND_ORIGINS=http://localhost:3000,https://your-project.vercel.app
COOKIE_SECURE=false

# Private email/password login for the portfolio administrator
ADMIN_EMAIL=mhanifudinfuadi@gmail.com
# Ganti dengan password hash yang aman (gunakan set_admin_password.py)
ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$xxx...
ADMIN_NAME=Hanif

# CRITICAL: Enable DB storage for Vercel deployment (filesystem is read-only on Vercel)
USE_DB_STORAGE=true

# Maximum request body size (Vercel default 4.5 MB, this is backend-level setting if supported)
MAX_BODY_SIZE=104857600

# Chunk size for image uploads (3MB each to stay under Vercel's 4.5MB limit)
CHUNK_SIZE=3145728

# Maximum image size: 14 MB
MAX_IMAGE_BYTES=14680064

# Maximum video size: 100 MB
MAX_VIDEO_BYTES=104857600

# Maximum audio size: 30 MB
MAX_AUDIO_BYTES=31457280

# CORS origins (add your production domain)
CORS_ORIGINS=http://localhost:3000,https://your-project.vercel.app,https://narative-storyteller.vercel.app
