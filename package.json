{
  "name": "web-porto-hanif",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "sh -c '(cd backend && venv/bin/python -m uvicorn server:app --host 0.0.0.0 --port 8000) & yarn --cwd frontend run dev'",
    "start": "yarn --cwd frontend run dev",
    "build": "yarn --cwd frontend run build",
    "install:all": "yarn --cwd frontend install",
    "dev:frontend": "yarn --cwd frontend run dev",
    "dev:backend": "cd backend && venv/bin/python -m uvicorn server:app --host 0.0.0.0 --port 8000"
  },
  "dependencies": {
    "dotenv": "^18.0.10"
  }
}
